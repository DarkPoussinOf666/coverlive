{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "global": {
    "color": {
      "gray": {
        "50": { "$value": "#FFFFFF", "$type": "color", "$description": "Adobe Spectrum Gray 50" },
        "75": { "$value": "#FAFAFA", "$type": "color", "$description": "Adobe Spectrum Gray 75" },
        "100": { "$value": "#F4F4F4", "$type": "color", "$description": "Adobe Spectrum Gray 100" },
        "200": { "$value": "#EAEAEA", "$type": "color", "$description": "Adobe Spectrum Gray 200" },
        "300": { "$value": "#D3D3D3", "$type": "color", "$description": "Adobe Spectrum Gray 300" },
        "400": { "$value": "#B1B1B1", "$type": "color", "$description": "Adobe Spectrum Gray 400" },
        "500": { "$value": "#8F8F8F", "$type": "color", "$description": "Adobe Spectrum Gray 500" },
        "600": { "$value": "#6D6D6D", "$type": "color", "$description": "Adobe Spectrum Gray 600" },
        "700": { "$value": "#464646", "$type": "color", "$description": "Adobe Spectrum Gray 700" },
        "800": { "$value": "#222222", "$type": "color", "$description": "Adobe Spectrum Gray 800" },
        "900": { "$value": "#000000", "$type": "color", "$description": "Adobe Spectrum Gray 900" }
      },
      "blue": {
        "400": { "$value": "#2680EB", "$type": "color", "$description": "Adobe Spectrum Blue 400" },
        "500": { "$value": "#1473E6", "$type": "color", "$description": "Adobe Spectrum Blue 500 (Informative core)" },
        "600": { "$value": "#0D66D0", "$type": "color", "$description": "Adobe Spectrum Blue 600" }
      },
      "green": {
        "400": { "$value": "#2D9D78", "$type": "color", "$description": "Adobe Spectrum Green 400" },
        "500": { "$value": "#12805C", "$type": "color", "$description": "Adobe Spectrum Green 500 (Positive core)" },
        "600": { "$value": "#0E6B4D", "$type": "color", "$description": "Adobe Spectrum Green 600" }
      },
      "orange": {
        "400": { "$value": "#F29423", "$type": "color", "$description": "Adobe Spectrum Orange 400" },
        "500": { "$value": "#E68619", "$type": "color", "$description": "Adobe Spectrum Orange 500 (Notice / Gold chord core)" },
        "600": { "$value": "#D97508", "$type": "color", "$description": "Adobe Spectrum Orange 600" }
      },
      "red": {
        "400": { "$value": "#EC5B62", "$type": "color", "$description": "Adobe Spectrum Red 400" },
        "500": { "$value": "#E34850", "$type": "color", "$description": "Adobe Spectrum Red 500 (Negative / Live Status core)" },
        "600": { "$value": "#D7373F", "$type": "color", "$description": "Adobe Spectrum Red 600" }
      }
    },
    "fontFamily": {
      "sans": {
        "$value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
        "$type": "fontFamily",
        "$description": "Adobe Clean fallback system font family"
      },
      "mono": {
        "$value": "'Source Code Pro', SFMono-Regular, Consolas, Monaco, monospace",
        "$type": "fontFamily",
        "$description": "Source Code Pro for music chords, tabs and digital readouts"
      }
    },
    "fontSize": {
      "50": { "$value": "11px", "$type": "dimension", "$description": "Spectrum font-size-50" },
      "75": { "$value": "12px", "$type": "dimension", "$description": "Spectrum font-size-75" },
      "100": { "$value": "14px", "$type": "dimension", "$description": "Spectrum font-size-100 (Desktop base)" },
      "200": { "$value": "16px", "$type": "dimension", "$description": "Spectrum font-size-200" },
      "300": { "$value": "18px", "$type": "dimension", "$description": "Spectrum font-size-300" },
      "400": { "$value": "20px", "$type": "dimension", "$description": "Spectrum font-size-400" },
      "500": { "$value": "22px", "$type": "dimension", "$description": "Spectrum font-size-500" },
      "600": { "$value": "25px", "$type": "dimension", "$description": "Spectrum font-size-600" },
      "700": { "$value": "28px", "$type": "dimension", "$description": "Spectrum font-size-700" },
      "800": { "$value": "32px", "$type": "dimension", "$description": "Spectrum font-size-800" },
      "900": { "$value": "36px", "$type": "dimension", "$description": "Spectrum font-size-900" },
      "1000": { "$value": "40px", "$type": "dimension", "$description": "Spectrum font-size-1000" }
    },
    "spacing": {
      "50": { "$value": "2px", "$type": "dimension", "$description": "Spectrum spacing-50" },
      "75": { "$value": "4px", "$type": "dimension", "$description": "Spectrum spacing-75" },
      "100": { "$value": "8px", "$type": "dimension", "$description": "Spectrum spacing-100" },
      "200": { "$value": "12px", "$type": "dimension", "$description": "Spectrum spacing-200" },
      "300": { "$value": "16px", "$type": "dimension", "$description": "Spectrum spacing-300" },
      "400": { "$value": "24px", "$type": "dimension", "$description": "Spectrum spacing-400" },
      "500": { "$value": "32px", "$type": "dimension", "$description": "Spectrum spacing-500" },
      "600": { "$value": "40px", "$type": "dimension", "$description": "Spectrum spacing-600" },
      "700": { "$value": "48px", "$type": "dimension", "$description": "Spectrum spacing-700 (Touch Target)" }
    },
    "borderRadius": {
      "none": { "$value": "0px", "$type": "dimension", "$description": "No border radius" },
      "small": { "$value": "2px", "$type": "dimension", "$description": "Spectrum small (2px)" },
      "regular": { "$value": "4px", "$type": "dimension", "$description": "Spectrum regular (4px)" },
      "large": { "$value": "8px", "$type": "dimension", "$description": "Spectrum large (8px)" },
      "full": { "$value": "9999px", "$type": "dimension", "$description": "Spectrum full capsule" }
    }
  },
  "alias": {
    "darkest": {
      "backgroundColor": {
        "default": { "$value": "{global.color.gray.900}", "$type": "color" },
        "secondary": { "$value": "#0d121c", "$type": "color" },
        "tertiary": { "$value": "#141a29", "$type": "color" }
      },
      "textColor": {
        "default": { "$value": "{global.color.gray.50}", "$type": "color" },
        "secondary": { "$value": "{global.color.gray.400}", "$type": "color" },
        "subdued": { "$value": "{global.color.gray.500}", "$type": "color" }
      },
      "borderColor": {
        "default": { "$value": "#222a3d", "$type": "color" },
        "subdued": { "$value": "#181f2f", "$type": "color" }
      },
      "focusRing": {
        "color": { "$value": "{global.color.blue.400}", "$type": "color" },
        "width": { "$value": "2px", "$type": "dimension" },
        "offset": { "$value": "2px", "$type": "dimension" }
      }
    },
    "light": {
      "backgroundColor": {
        "default": { "$value": "{global.color.gray.50}", "$type": "color" },
        "secondary": { "$value": "{global.color.gray.100}", "$type": "color" },
        "tertiary": { "$value": "{global.color.gray.200}", "$type": "color" }
      },
      "textColor": {
        "default": { "$value": "{global.color.gray.900}", "$type": "color" },
        "secondary": { "$value": "{global.color.gray.700}", "$type": "color" },
        "subdued": { "$value": "{global.color.gray.600}", "$type": "color" }
      },
      "borderColor": {
        "default": { "$value": "{global.color.gray.300}", "$type": "color" },
        "subdued": { "$value": "{global.color.gray.200}", "$type": "color" }
      },
      "focusRing": {
        "color": { "$value": "{global.color.blue.500}", "$type": "color" },
        "width": { "$value": "2px", "$type": "dimension" },
        "offset": { "$value": "2px", "$type": "dimension" }
      }
    }
  }
}
